{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HoutInvoer",
  "description": "Invoer voor een houten balk of balklaag.",
  "type": "object",
  "required": [
    "algemeen",
    "element",
    "sterkteklasse"
  ],
  "properties": {
    "algemeen": {
      "description": "Gemeenschappelijke invoer.",
      "allOf": [
        {
          "$ref": "#/definitions/Algemeen"
        }
      ]
    },
    "breedte_mm": {
      "description": "Breedte in mm (assortiment 46, 58, 71, 96; andere waarden toegestaan).",
      "default": 71.0,
      "type": "number",
      "format": "double"
    },
    "drukrand_gesteund": {
      "description": "Drukrand doorgaand gesteund (kip: k_crit = 1).",
      "default": true,
      "type": "boolean"
    },
    "dwarsverbinding": {
      "description": "Dwarsverbinding midden overspanning (alleen balklaag); vergroot b_ef voor w_1kN.",
      "anyOf": [
        {
          "$ref": "#/definitions/Dwarsverbinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "element": {
      "description": "Type element en belastingstrook.",
      "allOf": [
        {
          "$ref": "#/definitions/HoutElement"
        }
      ]
    },
    "hoogte_automatisch": {
      "description": "Hoogte automatisch kiezen uit het assortiment.",
      "default": true,
      "type": "boolean"
    },
    "hoogte_mm": {
      "description": "Vaste hoogte in mm, verplicht als `hoogte_automatisch` onwaar is.",
      "default": null,
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "klimaatklasse": {
      "description": "Klimaatklasse (1 of 2).",
      "default": 1,
      "type": "integer",
      "format": "uint8",
      "maximum": 2.0,
      "minimum": 1.0
    },
    "sterkteklasse": {
      "description": "Sterkteklasse.",
      "allOf": [
        {
          "$ref": "#/definitions/Houtklasse"
        }
      ]
    },
    "trillingstoets": {
      "description": "Trillingstoets (EC5 7.3) meenemen; bij onwaar wordt trilling niet beoordeeld.",
      "default": true,
      "type": "boolean"
    },
    "vloerbreedte_m": {
      "description": "Vloerbreedte B in m (dwars op de balken; alleen balklaag).",
      "default": null,
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "vloerlagen": {
      "description": "Lagen op de balklaag voor (EI)_T (alleen balklaag). Alleen lagen van soort vloerplaat tellen mee in k_r; de lagen tellen niet mee in (EI)_L.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Vloerlaag"
      }
    },
    "vloerplaat": {
      "description": "Verouderd: vloerplaat op de balklaag. Wordt intern een laag van soort vloerplaat; niet combineerbaar met `vloerlagen`.",
      "anyOf": [
        {
          "$ref": "#/definitions/Vloerplaat"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Algemeen": {
      "description": "Invoer die voor alle materialen geldt.",
      "type": "object",
      "required": [
        "overspanning_m",
        "permanent_kn_m2"
      ],
      "properties": {
        "dak_afschot_procent": {
          "description": "Dak: afschot in procent (0 - 100).",
          "default": 1.6,
          "type": "number",
          "format": "double"
        },
        "dak_beloopbaar": {
          "description": "Dak: beloopbaar (belasting als vloer).",
          "default": false,
          "type": "boolean"
        },
        "dak_hellingshoek_graden": {
          "description": "Dak: hellingshoek in graden (0 - 60).",
          "default": 0.0,
          "type": "number",
          "format": "double"
        },
        "eigen_gewicht_automatisch": {
          "description": "Eigen gewicht van het element automatisch meenemen.",
          "default": true,
          "type": "boolean"
        },
        "gebouwtype": {
          "description": "Gebouwtype; bepaalt de minimale gevolgklasse.",
          "default": "eengezinswoning1_tot3",
          "allOf": [
            {
              "$ref": "#/definitions/Gebouwtype"
            }
          ]
        },
        "gebruiksfunctie": {
          "description": "Gebruiksfunctie (bij dak alleen van belang als het dak beloopbaar is).",
          "default": "woon_vloer",
          "allOf": [
            {
              "$ref": "#/definitions/Gebruiksfunctie"
            }
          ]
        },
        "gevolgklasse": {
          "description": "Gevolgklasse; `None` volgt het gebouwtype. Lager dan de default is niet toegestaan.",
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Gevolgklasse"
            },
            {
              "type": "null"
            }
          ]
        },
        "lichte_scheidingswanden": {
          "description": "Klasse lichte scheidingswanden.",
          "default": "geen",
          "allOf": [
            {
              "$ref": "#/definitions/Scheidingswanden"
            }
          ]
        },
        "overspanning_m": {
          "description": "Overspanning l in m (1,0 - 12,0).",
          "type": "number",
          "format": "double"
        },
        "permanent_kn_m2": {
          "description": "Permanente belasting g_k in kN/m2, zonder eigen gewicht van het element (0 - 15).",
          "type": "number",
          "format": "double"
        },
        "scheurgevoelige_scheidingswanden": {
          "description": "Scheurgevoelige scheidingswanden aanwezig.",
          "default": false,
          "type": "boolean"
        },
        "toepassing": {
          "description": "Toepassing: vloer of dak.",
          "default": "vloer",
          "allOf": [
            {
              "$ref": "#/definitions/Toepassing"
            }
          ]
        },
        "uiterlijk_van_belang": {
          "description": "Uiterlijk van belang (toets op w_max).",
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Dwarsverbinding": {
      "description": "Doorgaand dwarselement (klossen, kruisverband) in het midden van de overspanning.",
      "type": "object",
      "required": [
        "ei_nm2"
      ],
      "properties": {
        "ei_nm2": {
          "description": "Buigstijfheid EI van het doorgaande dwarselement in Nm2 (heel element; 1e3 - 1e8).",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "Gebouwtype": {
      "description": "Gebouwtype (bepaalt de minimale gevolgklasse).",
      "oneOf": [
        {
          "description": "Eengezinswoning, 1 tot 3 bouwlagen.",
          "type": "string",
          "enum": [
            "eengezinswoning1_tot3"
          ]
        },
        {
          "description": "Eengezinswoning, 4 of meer bouwlagen.",
          "type": "string",
          "enum": [
            "eengezinswoning4_plus"
          ]
        },
        {
          "description": "Woongebouw.",
          "type": "string",
          "enum": [
            "woongebouw"
          ]
        },
        {
          "description": "Kantoorgebouw.",
          "type": "string",
          "enum": [
            "kantoorgebouw"
          ]
        }
      ]
    },
    "Gebruiksfunctie": {
      "description": "Gebruiksfunctie van de vloer (bepaalt categorie en veranderlijke belasting).",
      "oneOf": [
        {
          "description": "Categorie A, woonfunctie, vloer.",
          "type": "string",
          "enum": [
            "woon_vloer"
          ]
        },
        {
          "description": "Categorie A, woonfunctie, trap.",
          "type": "string",
          "enum": [
            "woon_trap"
          ]
        },
        {
          "description": "Categorie A, woonfunctie, balkon.",
          "type": "string",
          "enum": [
            "woon_balkon"
          ]
        },
        {
          "description": "Categorie A, gemeenschappelijke ruimte (vloer, trap, balkon).",
          "type": "string",
          "enum": [
            "gemeenschappelijk"
          ]
        },
        {
          "description": "Categorie B, kantoor.",
          "type": "string",
          "enum": [
            "kantoor"
          ]
        }
      ]
    },
    "Gevolgklasse": {
      "description": "Gevolgklasse.",
      "oneOf": [
        {
          "description": "Gevolgklasse 1.",
          "type": "string",
          "enum": [
            "CC1"
          ]
        },
        {
          "description": "Gevolgklasse 2.",
          "type": "string",
          "enum": [
            "CC2"
          ]
        },
        {
          "description": "Gevolgklasse 3 (buiten scope v1).",
          "type": "string",
          "enum": [
            "CC3"
          ]
        }
      ]
    },
    "HoutElement": {
      "description": "Type houten element met de bijbehorende belastingstrook.",
      "oneOf": [
        {
          "description": "Balklaag: balken op hart-op-hart-afstand; belastingstrook is gelijk aan de hoh-afstand.",
          "type": "object",
          "required": [
            "hoh_mm",
            "type"
          ],
          "properties": {
            "hoh_mm": {
              "description": "Hart-op-hart-afstand in mm (200 - 1200; gangbaar 300, 400, 500, 600).",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "enum": [
                "balklaag"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Losse balk met een opgegeven belastingbreedte.",
          "type": "object",
          "required": [
            "belastingbreedte_m",
            "type"
          ],
          "properties": {
            "belastingbreedte_m": {
              "description": "Belastingbreedte in m.",
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "enum": [
                "balk"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "Houtklasse": {
      "description": "Sterkteklasse hout (naaldhout, EN 338).",
      "oneOf": [
        {
          "description": "C14.",
          "type": "string",
          "enum": [
            "C14"
          ]
        },
        {
          "description": "C16.",
          "type": "string",
          "enum": [
            "C16"
          ]
        },
        {
          "description": "C18.",
          "type": "string",
          "enum": [
            "C18"
          ]
        },
        {
          "description": "C20.",
          "type": "string",
          "enum": [
            "C20"
          ]
        },
        {
          "description": "C22.",
          "type": "string",
          "enum": [
            "C22"
          ]
        },
        {
          "description": "C24.",
          "type": "string",
          "enum": [
            "C24"
          ]
        },
        {
          "description": "C27.",
          "type": "string",
          "enum": [
            "C27"
          ]
        },
        {
          "description": "C30.",
          "type": "string",
          "enum": [
            "C30"
          ]
        }
      ]
    },
    "Scheidingswanden": {
      "description": "Klasse lichte scheidingswanden (gewicht per strekkende meter wand).",
      "oneOf": [
        {
          "description": "Geen lichte scheidingswanden.",
          "type": "string",
          "enum": [
            "geen"
          ]
        },
        {
          "description": "Wandgewicht tot 1,0 kN/m.",
          "type": "string",
          "enum": [
            "tot_een"
          ]
        },
        {
          "description": "Wandgewicht tot 2,0 kN/m.",
          "type": "string",
          "enum": [
            "tot_twee"
          ]
        },
        {
          "description": "Wandgewicht tot 3,0 kN/m.",
          "type": "string",
          "enum": [
            "tot_drie"
          ]
        }
      ]
    },
    "Toepassing": {
      "description": "Toepassing van het veld.",
      "oneOf": [
        {
          "description": "Vloer.",
          "type": "string",
          "enum": [
            "vloer"
          ]
        },
        {
          "description": "Dak.",
          "type": "string",
          "enum": [
            "dak"
          ]
        }
      ]
    },
    "Vloerlaag": {
      "description": "Laag op de balklaag die bijdraagt aan (EI)_T; de stijfheid is invoer van de gebruiker.",
      "type": "object",
      "required": [
        "dikte_mm",
        "e_mean_n_mm2",
        "soort"
      ],
      "properties": {
        "dikte_mm": {
          "description": "Laagdikte in mm.",
          "type": "number",
          "format": "double"
        },
        "e_mean_n_mm2": {
          "description": "Gemiddelde elasticiteitsmodulus in N/mm2 (bron: invoer gebruiker, per product).",
          "type": "number",
          "format": "double"
        },
        "soort": {
          "description": "Soort laag.",
          "allOf": [
            {
              "$ref": "#/definitions/VloerlaagSoort"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "VloerlaagSoort": {
      "description": "Soort laag op de balklaag voor de stijfheid (EI)_T.",
      "oneOf": [
        {
          "description": "Vloerplaat (beplanking); alleen dit soort telt mee in k_r.",
          "type": "string",
          "enum": [
            "vloerplaat"
          ]
        },
        {
          "description": "Dekvloer.",
          "type": "string",
          "enum": [
            "dekvloer"
          ]
        },
        {
          "description": "Plafond (onderzijde).",
          "type": "string",
          "enum": [
            "plafond"
          ]
        },
        {
          "description": "Overige laag.",
          "type": "string",
          "enum": [
            "overig"
          ]
        }
      ]
    },
    "Vloerplaat": {
      "description": "Vloerplaat (beplanking) op een balklaag; de stijfheid is invoer van de gebruiker.",
      "type": "object",
      "required": [
        "dikte_mm",
        "e_mean_n_mm2"
      ],
      "properties": {
        "dikte_mm": {
          "description": "Plaatdikte in mm.",
          "type": "number",
          "format": "double"
        },
        "e_mean_n_mm2": {
          "description": "Gemiddelde elasticiteitsmodulus in N/mm2 (bron: invoer gebruiker, per productsoort).",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    }
  }
}